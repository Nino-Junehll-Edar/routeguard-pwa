  .filters button.on { border-color:var(--primary); color:var(--primary); background:var(--primary-surface); }
  .list { overflow-y:auto; flex:1; }
  .item { display:flex; gap:10px; align-items:center; width:100%; padding:12px; text-align:left;
    border:none; border-bottom:1px solid var(--border); background:var(--surface); font:inherit; cursor:pointer; }
  .item.on { background:var(--primary-surface); }
