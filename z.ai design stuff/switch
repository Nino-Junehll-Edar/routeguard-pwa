<script lang="ts">
  import { createEventDispatcher } from 'svelte';
  export let checked = false;
  export let label = '';
  const dispatch = createEventDispatcher<{ change: boolean }>();
</script>
<button type="button" role="switch" aria-checked={checked} aria-label={label}
  class="sw" class:on={checked}
  on:click={() => { checked = !checked; dispatch('change', checked); }}>
  <span class="knob" />
</button>
<style>
  .sw { width:40px; height:23px; border-radius:999px; background:var(--neutral-sf); border:none;
    position:relative; cursor:pointer; transition:background .2s; flex:none; }
  .sw.on { background:var(--primary); }
  .knob { position:absolute; top:2.5px; left:3px; width:18px; height:18px; border-radius:50%;
    background:#fff; box-shadow:var(--e1); transition:transform .2s var(--ease); }
  .sw.on .knob { transform:translateX(16px); }
</style>