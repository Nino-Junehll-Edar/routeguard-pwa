## 1. `src/lib/components/core/AppShell.svelte`

*Baked in: role-aware FAB menu (agency → Report + Agency Console; admin → Report + Agency + Admin) · consoles and auth pages are now "immersive" — they render their own chrome, so no more doubled navigation (BottomNav/SideRail never appear on `/agency/*`, `/admin/*`, or auth routes) · role now correctly read from `$profile` (not `$user`).*

```svelte
<script lang="ts">
  import { goto } from '$app/navigation';
  import { page } from '$app/stores';
  import { user } from '$lib/authStore';
  import { profile } from '$lib/stores/profile';
  import { wide } from '$lib/stores/media';
  import { online } from '$lib/stores/online';
  import { toast } from '$lib/stores/toast';
  import BottomNav from './BottomNav.svelte';
  import SideRail from './SideRail.svelte';
  import Banner from '../primitives/Banner.svelte';
  import Icon from '../Icon.svelte';

  let menuOpen = false;

  /* Full-screen surfaces render their own chrome — no app nav on top of them */
  const immersive = (p: string) =>
    p.startsWith('/report') || p.startsWith('/advisories') ||
    p.startsWith('/agency') || p.startsWith('/admin') ||
    p === '/login' || p === '/register' || p === '/agency-request';

  $: role = $profile?.role ?? null;
  $: hidden = immersive($page.url.pathname);
  $: menuItems = [
    { href: '/report', icon: 'plus', label: 'Report a hazard', show: true },
    { href: '/agency', icon: 'shield-check', label: 'Agency Console', show: role === 'agency_personnel' || role === 'admin' },
    { href: '/admin', icon: 'gauge', label: 'Admin Console', show: role === 'admin' },
  ].filter((i) => i.show);

  function fab() {
    if (!$user) { toast('Sign in to report hazards', 'w'); return goto('/login'); }
    if (role === 'agency_personnel' || role === 'admin') { menuOpen = !menuOpen; return; }
    goto('/report');
  }
</script>

