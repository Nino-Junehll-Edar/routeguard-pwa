    ]}>
    <div slot="foot" class="foot">
      <a class="maplink" href="/"><Icon name="map" size={15} /> Open public map</a>
      <div class="who">
        <span class="av">{($profile?.full_name ?? 'A').slice(0, 2).toUpperCase()}</span>
