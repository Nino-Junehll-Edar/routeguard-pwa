6. src/routes/agency/review/+page.svelte
Baked in: ?h= deep-link preselect · liveHazards · cleaner map fly-to (fires on selection change + map ready) · refreshHazards() after confirm.

svelte

<script lang="ts">
  import MapCanvas from '$lib/components/core/MapCanvas.svelte';
  import Chip from '$lib/components/primitives/Chip.svelte';
  import Button from '$lib/components/primitives/Button.svelte';
  import EmptyState from '$lib/components/primitives/EmptyState.svelte';
  import Icon from '$lib/components/Icon.svelte';
  import { page } from '$app/stores';
  import { liveHazards, refreshHazards } from '$lib/data/hazards';
  import { officialConfirm } from '$lib/data/advisories';
  import { TAGS, SEVERITIES, STATUS_LABEL, TACLOBAN, toLatLng } from '$lib/constants';
  import { toast } from '$lib/stores/toast';
  import type { Hazard } from '$lib/types';

  type Filter = 'needs_verification' | 'unconfirmed' | 'all';
  let filter: Filter = 'needs_verification';
  let selectedId: string | null = null;
  let busy = false;
  let mapRef: MapCanvas;

  /* Deep link from Command Center: /agency/review?h=<hazard id> */
  $: { const qh = $page.url.searchParams.get('h'); if (qh && qh !== selectedId) selectedId = qh; }

  $: list = $liveHazards.filter((h) => (filter === 'all' ? true : h.status === filter));
  $: selected = (selectedId && $liveHazards.find((h) => h.id === selectedId)) ?? list[0] ?? null;

  function flyToSel() {
    const ll = selected && toLatLng(selected.location);
    if (ll && mapRef) mapRef.flyTo(ll.lat, ll.lng, 16);
  }
  $: if (selected) flyToSel();

  async function confirm(kind: 'hazard_active' | 'hazard_cleared') {
    if (!selected || busy) return;
    busy = true;
    try {
      await officialConfirm(selected.id, kind);
      toast(kind === 'hazard_active'
        ? 'Officially confirmed ACTIVE — public map updated'
        : 'Officially confirmed CLEARED — public map updated', 'g');
      await refreshHazards(); // realtime also refreshes; this keeps the queue snappy
    } catch (e: any) { toast(e?.message ?? 'Confirmation failed', 'r'); }
    finally { busy = false; }
  }
</script>

<div class="review">
  <aside class="card">
    <div class="filters">
      {#each [['needs_verification', 'Needs verification'], ['unconfirmed', 'Unconfirmed'], ['all', 'All open']] as [f, l]}
        <button class:on={filter === f} on:click={() => (filter = f as Filter)}>{l}</button>
      {/each}
    </div>
    <div class="list">
      {#each list as h (h.id)}
        <button class="item" class:on={selected?.id === h.id} on:click={() => (selectedId = h.id)}>
          <span class="ic">{TAGS[h.hazard_type]?.label?.[0] ?? '?'}</span>
          <span class="mid"><b>{TAGS[h.hazard_type]?.label ?? 'Hazard'}</b>
            <small>{new Date(h.created_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
              {#if h.severity} · {SEVERITIES[h.severity].label}{/if}</small></span>
          <Chip variant={h.status === 'needs_verification' ? 'warning' : 'neutral'}>{STATUS_LABEL[h.status]}</Chip>
        </button>
      {:else}<EmptyState icon="shield-check">Queue is clear.</EmptyState>{/each}
    </div>
  </aside>

  <section class="detail">
    {#if selected}
      <div class="mapbox card">
        <MapCanvas bind:this={mapRef} hazards={[selected]} advisories={[]} user={null}
          center={TACLOBAN} zoom={15} selectedId={selected.id} on:ready={flyToSel} />
      </div>
      <div class="info card">
        <div class="chips">
          <Chip variant="brand">{TAGS[selected.hazard_type]?.label}</Chip>
          {#if selected.severity}<Chip variant={selected.severity === 'impassable' ? 'danger' : 'warning'}>{SEVERITIES[selected.severity].label}</Chip>{/if}
          <Chip>{STATUS_LABEL[selected.status]}</Chip>
          {#if selected.verified_by}<Chip variant="advisory">LGU verified</Chip>{/if}
          <span class="hint tnum" style="margin-left:auto">{selected.confirmations_count ?? 0} confirmations</span>
        </div>
7. src/routes/+page.svelte (Map home)
Baked in: liveHazards · selection ring on the open pin · dismissed verification cards stay dismissed across realtime updates · sheet auto-closes if the hazard expires.

svelte

<script lang="ts">
  import { onMount } from 'svelte';
  import MapCanvas from '$lib/components/core/MapCanvas.svelte';
  import FloatingSearch from '$lib/components/features/FloatingSearch.svelte';
  import LayersPopover from '$lib/components/features/LayersPopover.svelte';
  import HazardSheet from '$lib/components/features/HazardSheet.svelte';
  import VerificationCard from '$lib/components/features/VerificationCard.svelte';
  import Legend from '$lib/components/primitives/Legend.svelte';
  import Icon from '$lib/components/Icon.svelte';
  import { initHazards, liveHazards, advisories, confirmHazard, refreshHazards } from '$lib/data/hazards';
  import { geo } from '$lib/stores/geo';
  import { toast } from '$lib/stores/toast';
  import { haversine, toLatLng } from '$lib/constants';

  let mapRef: MapCanvas;
  let showAdv = true;
  let layersOpen = false;
  let selectedId: string | null = null;
  let dismissedVer = new Set<string>();

  onMount(() => { initHazards(); });

  /* sheet target derives from the store — auto-updates on confirm, auto-closes on expiry */
  $: selected = selectedId ? ($liveHazards.find((h) => h.id === selectedId) ?? null) : null;

  /* nearest needs_verification hazard within alert radius, not dismissed */
  $: verifiable = $geo.lat != null
    ? ($liveHazards.find((h) => h.status === 'needs_verification'
        && !dismissedVer.has(h.id)
        && haversine({ lat: $geo.lat!, lng: $geo.lng! }, toLatLng(h.location)!) < 500) ?? null)
    : null;
  $: verifyDist = verifiable && $geo.lat != null
    ? Math.round(haversine({ lat: $geo.lat!, lng: $geo.lng! }, toLatLng(verifiable.location)!)) + ' m' : '';

  function dismissVerify() {
    if (!verifiable) return;
    dismissedVer = new Set([...dismissedVer, verifiable.id]); // reassign so reactivity fires
  }

  async function onVerify(e: CustomEvent<'hazard_active' | 'hazard_cleared'>) {
    if (!verifiable) return;
    try {
      await confirmHazard(verifiable.id, e.detail);
      toast(e.detail === 'hazard_active' ? 'Confirmed active — thanks!' : 'Confirmed cleared — thanks!', 'g');
      dismissVerify();
      refreshHazards();
    } catch { toast('Confirmation failed — check connection', 'r'); }
  }
</script>

<div class="map-page">
  <MapCanvas bind:this={mapRef} hazards={$liveHazards} advisories={$advisories}
    showAdvisories={showAdv} selectedId={selectedId}
    user={$geo.lat != null ? { lat: $geo.lat, lng: $geo.lng!, accuracy: $geo.accuracy } : null}
    on:hazardclick={(e) => (selectedId = e.detail)} />

  <FloatingSearch />
  <div class="mbtns">
    <button aria-label="Layers" on:click={() => (layersOpen = !layersOpen)}><Icon name="layers" size={21} /></button>
    <button aria-label="My location" on:click={() => $geo.lat != null && mapRef.flyTo($geo.lat, $geo.lng!, 16)}>
      <Icon name="locate" size={21} />
    </button>
  </div>
  <LayersPopover bind:open={layersOpen} bind:showAdvisories />
  <Legend />

  {#if verifiable && !selected}
    <VerificationCard hazard={verifiable} distance={verifyDist} on:confirm={onVerify} on:dismiss={dismissVerify} />
Required companion append — src/lib/styles/map.css
The selection pulse lives here (global, because Leaflet DOM sits outside Svelte scoping). Make sure this block is at the end of map.css:

css

.hz-wrap.sel::after{content:"";position:absolute;inset:-7px;border-radius:50%;
  border:3px solid var(--primary);animation:hz-sel 1.5s var(--ease) infinite}
@keyframes hz-sel{0%{transform:scale(.8);opacity:.9}100%{transform:scale(1.3);opacity:0}}
Three integration notes
SQL order matters: this code expects all three deltas applied — 002_ui_delta (severity, confirm trigger, adjust_hazard_lifetime), 003_advisory_geo (radius column, agency_advisories_geo view, create_advisory, official_confirm), 004_admin. The advisories store now reads the _geo view, so the public map breaks without 003.
refreshHazards() is new and exported — Command Center and admin can also call it after mutations; realtime remains the primary refresh path.
agencies/+page.svelte (Overview) still references $hazards — harmless (it counts non-expired manually), but swap to $liveHazards at your leisure per patch note #5.
That's the full consolidated set. Remaining from the old checklist if you want them emitted clean next: AppShell.svelte (agency FAB menu variant) and the login role-redirect handler — say the word.

