<script lang="ts">
  import { goto } from '$app/navigation';
  import { get } from 'svelte/store';
  import ConsoleShell from '$lib/components/core/ConsoleShell.svelte';
  import Button from '$lib/components/primitives/Button.svelte';
  import Icon from '$lib/components/Icon.svelte';
  import { user } from '$lib/authStore';
  import { profile, loadProfile, reviewCount } from '$lib/stores/profile';
  import { initHazards, hazards } from '$lib/data/hazards';

  let ready = false;
  $: init($user);
  async function init(u: any) {
    if (!u) return goto('/login');
    await loadProfile();
    const p = get(profile);
    if (!p || (p.role !== 'agency_personnel' && p.role !== 'admin')) return goto('/');
    initHazards();
    ready = true;
  }
  $: reviewCount.set($hazards.filter((h) => h.status === 'needs_verification').length);
</script>

{#if ready}
  <ConsoleShell title="Agency Console" subtitle="RouteGuard · Tacloban LGU"
