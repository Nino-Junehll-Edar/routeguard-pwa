<!doctype html><html lang="en" data-theme="light"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>RouteGuard — Unified Website Prototype v0.3</title>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#F7F8FA;--surface:#FFFFFF;--raised:#FFFFFF;--border:#DDE3EA;--ink:#12161A;--ink2:#4A545E;
--primary:#1B5CA8;--primary-ink:#0F3460;--primary-surface:#E7F0FA;--danger:#C4271E;--danger-sf:#FBE9E7;
--warning:#B45309;--warning-sf:#FCF0DD;--caution:#F0A400;--neutral:#64748B;--neutral-sf:#EEF1F5;
--success:#2E8555;--success-sf:#E4F3EB;--advisory:#6D28D9;--advisory-sf:#F1EAFB;--route:#1D66C9;--gold:#B7791F;
--map-land:#EDF1F6;--map-water:#C9E0F4;--map-road:#FFFFFF;--map-minor:#F2F5F9;--map-pk:#DDEAD9;--map-lbl:#5B6B7B;
--r-s:8px;--r-m:12px;--r-l:16px;--e1:0 1px 2px rgba(10,20,30,.12);--e2:0 4px 14px rgba(10,20,30,.16);--e3:0 12px 32px rgba(10,20,30,.22);
--ease:cubic-bezier(.32,.72,.24,1);--f:'Public Sans',system-ui,-apple-system,sans-serif;--navh:70px}
[data-theme=dark]{--bg:#0E1116;--surface:#161B22;--raised:#1C2430;--border:#2A3340;--ink:#E6EAF0;--ink2:#9AA7B4;
--primary:#5E93D6;--primary-ink:#C5D9F2;--primary-surface:#12283F;--danger:#FF6B4A;--danger-sf:#2E1512;
--warning:#FFC24B;--warning-sf:#2A1F0E;--caution:#E0B341;--neutral:#94A3B8;--neutral-sf:#1D242E;
--success:#4AC97E;--success-sf:#12271B;--advisory:#A78BFA;--advisory-sf:#1D1533;--route:#6EA8FF;--gold:#E9B44C;
--map-land:#12171E;--map-water:#0E2438;--map-road:#39434F;--map-minor:#1D242E;--map-pk:#17251B;--map-lbl:#7C8A99}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--f);background:var(--bg);color:var(--ink);font-size:14.5px;line-height:1.5;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
input,select,textarea{font:inherit;color:var(--ink)}
a{color:var(--primary);font-weight:700;text-decoration:none}
svg.ic{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
@media(prefers-reduced-motion:reduce){*{transition-duration:.01ms!important;animation-duration:.01ms!important}}
.tnum{font-variant-numeric:tabular-nums}.hint{font-size:12px;color:var(--ink2)}.sub{color:var(--ink2);font-size:13px}
#errbox{display:none;position:fixed;bottom:8px;left:8px;right:8px;z-index:9999;background:#7A2A20;color:#fff;font:12px/1.5 ui-monospace,monospace;padding:10px 12px;border-radius:8px;max-height:40vh;overflow:auto}
/* proto bar */
#proto{position:sticky;top:0;z-index:1000;display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:9px 16px;background:#101418;color:#E6EAF0;border-bottom:1px solid #232a33;font-size:13px}
#proto .lg{font-weight:800;display:flex;gap:8px;align-items:center;margin-right:auto}
#proto .lg svg{width:18px;height:18px;stroke:#5E93D6}#proto .lg span{color:#6b7684;font-weight:600}
.pbtn{padding:5px 12px;border:1px solid #333d49;border-radius:8px;color:#9AA7B4;font-weight:600;font-size:12.5px}
.pbtn.on{background:#152a18;border-color:#2E8555;color:#7EE2A8}
/* views */
.view{display:none}.view.on{display:block}
/* ============ AUTH (slider card) ============ */
#view-auth.on{display:flex;min-height:calc(100vh - 52px);align-items:center;justify-content:center;padding:24px 16px;background:linear-gradient(160deg,var(--primary-surface),var(--bg) 55%,var(--advisory-sf))}
.brand{display:flex;flex-direction:column;align-items:center;gap:8px;margin-bottom:20px;text-align:center}
.mark{width:64px;height:64px;border-radius:18px;background:var(--primary);color:#fff;display:grid;place-items:center;box-shadow:var(--e2)}
.mark svg{width:34px;height:34px}
.brand b{font-size:21px;font-weight:800;letter-spacing:-.3px}
.brand span{font-size:13px;color:var(--ink2)}
.acard{--acc:var(--primary);width:min(560px,100%);background:var(--surface);border:1px solid var(--border);border-top:4px solid var(--acc);border-radius:20px;box-shadow:var(--e3);padding:22px 26px 20px;transition:border-color .3s}
.acard[data-side=agency]{--acc:var(--advisory)}
.pill2{display:flex;background:var(--neutral-sf);border-radius:999px;padding:4px;margin-bottom:18px}
.pill2 button{flex:1;padding:10px;border-radius:999px;font-weight:800;font-size:13.5px;color:var(--ink2);display:flex;gap:8px;align-items:center;justify-content:center;transition:all .25s var(--ease)}
.pill2 button.on{background:var(--surface);color:var(--acc);box-shadow:var(--e1)}
.aslide{overflow:hidden}
.atrack{display:flex;width:200%;transition:transform .35s var(--ease)}
.atrack.ag{transform:translateX(-50%)}
.apane{width:50%;padding:0 2px}
.minitabs{display:flex;gap:18px;border-bottom:1.5px solid var(--border);margin-bottom:16px}
.minitabs button{padding:9px 2px;font-weight:700;font-size:13.5px;color:var(--ink2);border-bottom:2.5px solid transparent;margin-bottom:-1.5px}
.minitabs button.on{color:var(--acc);border-color:var(--acc)}
.fld{margin-bottom:12px}
.fld label{display:block;font-size:12px;font-weight:700;color:var(--ink2);margin-bottom:5px}
.in{width:100%;min-height:46px;padding:0 13px;border:1.5px solid var(--border);border-radius:var(--r-m);background:var(--surface);font-size:14px}
textarea.in{padding:11px 13px;min-height:70px;resize:vertical}
.in:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px var(--primary-surface)}
.acard[data-side=agency] .in:focus{box-shadow:0 0 0 3px var(--advisory-sf)}
.pwwrap{position:relative}.pwwrap .toggle{position:absolute;right:5px;top:50%;transform:translateY(-50%);color:var(--ink2);width:34px;height:34px;display:grid;place-items:center;border-radius:8px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 18px;border-radius:var(--r-m);background:var(--primary);color:#fff;font-weight:700;font-size:14px;transition:transform .12s var(--ease)}
[data-theme=dark] .btn{color:#0B1420}
.btn:active{transform:scale(.98)}.btn:disabled{opacity:.5;cursor:default}
.btn.b2{background:var(--surface);color:var(--primary);border:1.5px solid var(--border)}
.btn.g{background:transparent;color:var(--ink2)}
.btn.d{background:var(--danger);color:#fff}[data-theme=dark] .btn.d{color:#2A0D08}
.btn.adv{background:var(--advisory);color:#fff}[data-theme=dark] .btn.adv{color:#160B28}
.btn.sm{min-height:34px;padding:0 13px;font-size:12.5px}.blk{width:100%}
.agc{border:1.5px solid var(--advisory)!important;background:var(--advisory-sf)!important;color:var(--advisory)!important}
.pwstr{display:flex;gap:5px;margin-top:7px}.pwstr i{height:4px;flex:1;border-radius:99px;background:var(--border)}.pwstr i.on{background:var(--success)}
.alt{display:flex;gap:8px;align-items:center;margin-top:14px;font-size:13px;color:var(--ink2)}
.alt b{color:var(--acc);cursor:pointer}
.ahint{font-size:12px;color:var(--ink2);background:var(--neutral-sf);border-radius:var(--r-s);padding:9px 11px;margin:10px 0}
.drow{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;padding-top:14px;border-top:1px dashed var(--border)}
.drow .db{flex:1;min-width:150px;background:var(--neutral-sf);color:var(--ink);border:1.5px solid var(--border)}
.drow .db small{display:block;font-weight:600;font-size:10.5px;color:var(--ink2)}
.okbox{display:none;text-align:center;padding:18px 6px}
.okbox.on{display:block}
.okc{width:74px;height:74px;border-radius:50%;background:var(--success-sf);color:var(--success);display:grid;place-items:center;margin:0 auto 12px;animation:pop .5s var(--ease)}
.okc.blue{background:var(--primary-surface);color:var(--primary)}
.okc.vio{background:var(--advisory-sf);color:var(--advisory)}
.okc svg{width:36px;height:36px}
@keyframes pop{0%{transform:scale(0)}70%{transform:scale(1.15)}100%{transform:scale(1)}}
.guestlnk{display:block;width:100%;text-align:center;margin-top:16px;padding-top:14px;border-top:1px solid var(--border);font-size:13px;font-weight:700;color:var(--ink2)}
.guestlnk b{color:var(--primary)}
/* ============ APP SHELL ============ */
#view-app.on{display:flex;flex-direction:column;height:calc(100vh - 52px)}
.apphead{flex:none;display:flex;align-items:center;gap:6px;padding:8px 16px;background:var(--surface);border-bottom:1px solid var(--border)}
.apphead .hlogo{display:flex;gap:8px;align-items:center;font-weight:800;margin-right:14px}
.apphead .hlogo svg{color:var(--primary)}
.hnav{display:flex;gap:2px}
.hnav button{padding:9px 14px;border-radius:var(--r-s);font-weight:600;font-size:13.5px;color:var(--ink2);position:relative}
.hnav button.on{background:var(--primary-surface);color:var(--primary)}
.hnav button .nd{position:absolute;top:7px;right:9px;width:7px;height:7px;border-radius:99px;background:var(--danger)}
.hspace{flex:1}
.rolechip{display:flex;gap:8px;align-items:center;font-size:12.5px;font-weight:700;color:var(--ink2);padding:6px 10px;border-radius:999px;background:var(--neutral-sf)}
.rolechip .rdot{width:8px;height:8px;border-radius:99px;background:var(--rc,var(--neutral))}
.hav{width:36px;height:36px;border-radius:50%;background:var(--primary);color:#fff;display:grid;place-items:center;font-weight:800;font-size:13px}
#appMain{flex:1;position:relative;overflow:hidden}
#appMain .scr{position:absolute;inset:0;display:none;overflow:auto;overscroll-behavior:contain}
#appMain .scr.on{display:block}
.pagepad{padding:22px 26px 60px;max-width:860px;margin:0 auto;width:100%}
.bnav{display:none}
/* ============ MAP (shared) ============ */
.mapbox{position:absolute;inset:0;overflow:hidden;background:var(--map-land)}
.base,.ovl{position:absolute;inset:0;width:100%;height:100%}
.l{fill:var(--map-land)}.w{fill:var(--map-water)}.wv{fill:none;stroke:var(--map-water);stroke-width:16;stroke-linecap:round}
.pk{fill:var(--map-pk)}
.rd{stroke:var(--map-minor);stroke-width:5;fill:none}.rdm{stroke:var(--map-road);stroke-width:9;fill:none}
.lb{fill:var(--map-lbl);font:600 11px var(--f);letter-spacing:.4px}.lb.big{font:800 17px var(--f)}.lb.wt{fill:#5B84B0;font-style:italic}
.advL{stroke:var(--advisory);stroke-width:8;fill:none;stroke-linecap:round}.advL.roadwork{stroke-dasharray:14 10}
.advZ{fill:var(--advisory-sf);stroke:var(--advisory);stroke-width:2.5}
.advC{fill:var(--advisory);fill-opacity:.14;stroke:var(--advisory);stroke-width:2.5}
.advDot{fill:var(--advisory);stroke:var(--surface);stroke-width:2.5}
.advT{font:800 12px var(--f);fill:var(--advisory);letter-spacing:.4px;paint-order:stroke;stroke:var(--bg);stroke-width:4px;pointer-events:none}
.hit{stroke:rgba(0,0,0,0);stroke-width:22;fill:none}.advG,.hpin{cursor:pointer}.hpin use{pointer-events:none}
.hpin .selring{display:none;fill:none;stroke:var(--primary);stroke-width:3;transform-box:fill-box;transform-origin:center}
.hpin.sel .selring{display:block;animation:selp 1.5s var(--ease) infinite}
@keyframes selp{0%{transform:scale(.85);opacity:.9}100%{transform:scale(1.5);opacity:0}}
.hpin.cleared{opacity:.55}
.rtline{stroke:var(--route);stroke-width:8;fill:none;stroke-linecap:round;stroke-linejoin:round}
 rtc{stroke:var(--surface);stroke-width:13;fill:none;stroke-linecap:round;stroke-linejoin:round;opacity:.92}
 rtc{stroke:var(--surface);stroke-width:13;fill:none;stroke-linecap:round;opacity:.92}
.udotG circle{fill:var(--route);stroke:var(--surface);stroke-width:3.5}
.mzoom{position:absolute;inset:0;transition:transform .5s var(--ease)}.mzoom.on{transform:scale(1.9)}
/* furniture */
.srpill{position:absolute;top:14px;left:14px;right:14px;z-index:20;display:flex;align-items:center;gap:10px;background:var(--raised);border:1px solid var(--border);border-radius:999px;padding:11px 16px;box-shadow:var(--e2);font-size:13.5px;color:var(--ink2);max-width:520px}
.srpill .bell{margin-left:auto;color:var(--ink);position:relative;display:grid;place-items:center}
.srpill .bell i{position:absolute;top:-3px;right:-4px;width:9px;height:9px;background:var(--danger);border-radius:99px;border:2px solid var(--raised)}
.mbtns{position:absolute;right:14px;bottom:96px;z-index:20;display:flex;flex-direction:column;gap:10px}
.mbt{width:46px;height:46px;border-radius:var(--r-m);background:var(--raised);border:1px solid var(--border);box-shadow:var(--e1);display:grid;place-items:center;color:var(--ink2)}
.obanner{position:absolute;top:66px;left:14px;z-index:21;display:none;align-items:center;gap:8px;background:var(--warning-sf);color:var(--warning);border:1px solid var(--warning);border-radius:var(--r-m);padding:8px 12px;font-size:12px;font-weight:700}
.obanner.on{display:flex}
.legend{position:absolute;left:14px;bottom:20px;z-index:20}
.legbtn{display:flex;align-items:center;gap:7px;background:var(--raised);border:1px solid var(--border);border-radius:999px;padding:8px 14px;font-size:12px;font-weight:700;box-shadow:var(--e1)}
.legcard{display:none;background:var(--raised);border:1px solid var(--border);border-radius:var(--r-l);box-shadow:var(--e2);padding:12px 14px;width:200px}
.legend.open .legcard{display:block}.legend.open .legbtn{display:none}
.lrow{display:flex;align-items:center;gap:9px;font-size:11.5px;color:var(--ink2);padding:3.5px 0}
.lpin{width:15px;height:15px;border-radius:50%;border:2px solid var(--surface);box-shadow:var(--e1);flex:none}
.lpin.dash{border-style:dashed;background:var(--surface)}
.lsh{width:15px;height:15px;border-radius:50%;background:var(--primary-ink);display:grid;place-items:center;flex:none}
.lsh svg{width:8px;height:8px;stroke:#fff;stroke-width:3;fill:none}
.lln{width:20px;border-top:3px dashed var(--advisory);flex:none}.lln.rt2{border-top:4px solid var(--route);border-top-style:solid}
#vc{position:absolute;left:14px;right:14px;bottom:96px;z-index:25;max-width:460px;background:var(--raised);border:1px solid var(--border);border-left:4px solid var(--warning);border-radius:var(--r-l);box-shadow:var(--e2);padding:13px;display:none}
#vc.on{display:block}
#vc .t{font-weight:800;font-size:13.5px;display:flex;gap:8px;align-items:center;color:var(--warning)}
#vc .s{font-size:12px;color:var(--ink2);margin:3px 0 10px}
#vc .acts{display:flex;gap:8px}#vc .acts .btn{flex:1;min-height:40px;font-size:12.5px}
#vc .x{position:absolute;top:6px;right:6px;color:var(--ink2);width:30px;height:30px;display:grid;place-items:center}
#fabmenu{position:absolute;right:14px;bottom:150px;z-index:35;display:none;flex-direction:column;gap:8px;width:220px}
#fabmenu.on{display:flex}
#fabmenu button{display:flex;gap:10px;align-items:center;background:var(--raised);border:1px solid var(--border);border-radius:var(--r-m);padding:12px 14px;font-weight:700;font-size:13px;box-shadow:var(--e2);text-align:left}
#fabmenu button svg{color:var(--primary)}
/* hazard sheet: bottom sheet on mobile, right panel on desktop */
.backdrop{position:absolute;inset:0;background:rgba(8,14,22,.38);z-index:24;opacity:0;pointer-events:none;transition:opacity .25s}
.backdrop.on{opacity:1;pointer-events:auto}
.hsheet{position:absolute;z-index:28;background:var(--surface);box-shadow:var(--e3);display:flex;flex-direction:column;
 left:0;right:0;bottom:0;height:84%;border-radius:20px 20px 0 0;transform:translateY(103%);transition:transform .28s var(--ease)}
.hsheet.p1{transform:translateY(calc(100% - 150px))}.hsheet.p2{transform:translateY(45%)}.hsheet.p3{transform:translateY(3%)}
.grab{padding:9px 0 5px;display:grid;place-items:center;cursor:pointer;flex:none}
.grab span{width:40px;height:5px;border-radius:99px;background:var(--border)}
.shbody{overflow-y:auto;padding:2px 18px 16px;flex:1}
.shrow{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-bottom:5px}
.shbody h3{font-size:16.5px;font-weight:800}
.shsub{font-size:12px;color:var(--ink2);margin-bottom:11px}
.cphoto{height:140px;border-radius:var(--r-m);background:linear-gradient(135deg,var(--primary-surface),var(--neutral-sf));display:flex;flex-direction:column;gap:5px;align-items:center;justify-content:center;color:var(--ink2);font-size:12px;font-weight:600;margin-bottom:11px}
.cphoto svg{width:24px;height:24px}
.desc{font-size:13.5px;margin-bottom:11px}
.kv{display:flex;justify-content:space-between;gap:10px;font-size:12.5px;padding:8px 0;border-bottom:1px solid var(--border);align-items:center}
.kv span{color:var(--ink2)}.kv b{font-weight:700;text-align:right}
.tline{border-left:2px solid var(--border);margin:10px 0 12px 6px;padding-left:13px}
.tline .te{position:relative;padding-bottom:10px;font-size:12px}
.tline .te::before{content:"";position:absolute;left:-19px;top:3px;width:9px;height:9px;border-radius:99px;background:var(--neutral)}
.tline .te:first-child::before{background:var(--primary)}
.tline .te b{display:block;font-size:12.5px}
.cmt{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--border);font-size:12.5px}
.cmt .cav{width:28px;height:28px;border-radius:50%;background:var(--primary-surface);color:var(--primary);display:grid;place-items:center;font-weight:800;font-size:11px;flex:none}
.crow{display:flex;gap:8px;margin-top:11px}.crow .in{min-height:42px}
.shacts{padding:10px 18px 14px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:8px;flex:none;background:var(--surface)}
.shacts .pair{display:flex;gap:8px}.shacts .btn{min-height:44px;font-size:13px}.shacts .pair .btn{flex:1}
.chip{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:var(--neutral-sf);color:var(--ink2);white-space:nowrap}
.chip.p{background:var(--primary-surface);color:var(--primary)}.chip.r{background:var(--danger-sf);color:var(--danger)}
.chip.a{background:var(--warning-sf);color:var(--warning)}.chip.c{background:var(--warning-sf);color:var(--caution)}
.chip.gn{background:var(--success-sf);color:var(--success)}.chip.v{background:var(--advisory-sf);color:var(--advisory)}
.chip.gd{background:var(--warning-sf);color:var(--gold)}
/* report */
.rephead{display:flex;align-items:center;gap:10px;padding:16px 20px 8px;max-width:640px;margin:0 auto;width:100%}
.rephead .h2{flex:1;font-size:17px;font-weight:800}
.steps{display:flex;gap:6px;padding:0 20px 14px;max-width:640px;margin:0 auto;width:100%}
.steps i{height:4px;flex:1;border-radius:99px;background:var(--border)}.steps i.on{background:var(--primary)}
.rstep{display:none;max-width:640px;margin:0 auto;width:100%;padding:4px 20px 30px}
.rstep.on{display:block}
.taggrid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
.tagtile{display:flex;flex-direction:column;align-items:center;gap:7px;padding:14px 4px 11px;border:1.5px solid var(--border);border-radius:var(--r-m);background:var(--surface);font-size:11px;font-weight:700;color:var(--ink2)}
.tagtile svg{width:23px;height:23px;stroke:var(--primary);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.tagtile.on{border-color:var(--primary);background:var(--primary-surface);color:var(--primary)}
.sevrow{display:flex;gap:8px;margin:10px 0 4px}
.sevc{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;padding:11px 4px;border-radius:var(--r-m);border:1.5px solid var(--border);font-size:12.5px;font-weight:700;background:var(--surface)}
.sevc i{width:9px;height:9px;border-radius:99px;flex:none}
.sevc[data-s=passable] i{background:var(--caution)}.sevc[data-s=one_lane] i{background:var(--warning)}.sevc[data-s=impassable] i{background:var(--danger)}
.sevc.on{border-color:var(--primary);background:var(--primary-surface)}
.pphoto{display:none;align-items:center;gap:10px;margin-top:10px;padding:10px;border:1px dashed var(--border);border-radius:var(--r-m);font-size:12.5px}
.pphoto.on{display:flex}
.pphoto .thumb{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,var(--primary-surface),var(--neutral-sf));flex:none}
.locbox{margin-top:13px;padding:12px 14px;border:1px solid var(--border);border-radius:var(--r-m);display:flex;flex-direction:column;gap:3px;font-size:13px;background:var(--surface)}
.rv{padding:11px 0;border-bottom:1px solid var(--border);font-size:13.5px;display:flex;justify-content:space-between;gap:12px}
