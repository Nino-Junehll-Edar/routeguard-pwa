/* ================= SVG MAP RENDERING ================= */
function pinSvg(p,sel){
 var color=p.status==='hazard_cleared'?'var(--success)':(p.sev==='impassable'?'var(--danger)':p.sev==='one_lane'?'var(--warning)':'var(--caution)');
 var dash=(!p.verified&&p.confirmed<2)?' stroke-dasharray="4 3"':'';
 var s='<g class="hpin'+(sel?' sel':'')+(p.status==='hazard_cleared'?' cleared':'')+'" data-pin="'+p.id+'" transform="translate('+p.sx+' '+p.sy+')">'
  +'<circle r="15" fill="'+color+'" stroke="var(--surface)" stroke-width="2.5"'+dash+'/>'
  +'<use href="#t-'+p.tag+'" x="-8" y="-8" width="16" height="16" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';
 if(p.verified)s+='<g transform="translate(10 10)"><circle r="7.5" fill="var(--primary-ink)" stroke="var(--surface)" stroke-width="2"/><use href="#i-shieldc" x="-4.5" y="-4.5" width="9" height="9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></g>';
 if(p._queued)s+='<g transform="translate(-10 -10)"><circle r="7.5" fill="var(--surface)" stroke="var(--border)" stroke-width="1.5"/><use href="#i-clock" x="-4.5" y="-4.5" width="9" height="9" fill="none" stroke="var(--ink2)" stroke-width="2.4"/></g>';
 s+='<circle class="selring" r="17"/></g>';
 return s;}
function advSvg(a){
 var g=a.geom,s='<g class="advG" data-adv="'+a.id+'">';
 if(g.kind==='line'){var d='M'+g.pts.map(function(p){return p[0]+' '+p[1];}).join(' L');var m=g.pts[Math.floor(g.pts.length/2)];
  s+='<path class="hit" d="'+d+'"/><path class="advL '+a.type+'" d="'+d+'"/><text class="advT" x="'+(m[0]+10)+'" y="'+(m[1]-10)+'">'+a.title.toUpperCase()+'</text>';}
 else if(g.kind==='area'){var d2='M'+g.pts.map(function(p){return p[0]+' '+p[1];}).join(' L')+' Z';
  s+='<path class="advZ" d="'+d2+'"/><text class="advT" x="'+(g.pts[0][0]+8)+'" y="'+(g.pts[0][1]+18)+'">'+a.title.toUpperCase()+'</text>';}
 else{var c=g.pts[0];s+='<circle class="advC" cx="'+c[0]+'" cy="'+c[1]+'" r="'+g.r+'"/><circle class="advDot" cx="'+c[0]+'" cy="'+c[1]+'" r="5"/><text class="advT" x="'+(c[0]+12)+'" y="'+(c[1]-10)+'">'+a.title.toUpperCase()+'</text>';}
 return s+'</g>';}
function builderSvg(){var P=S.bPts;if(!P.length)return '';
 var d='M'+P.map(function(p){return p[0]+' '+p[1];}).join(' L'),s='';
 if(S.bMode==='point'&&P.length===1){s='<circle class="advC" cx="'+P[0][0]+'" cy="'+P[0][1]+'" r="'+S.bRadius+'"/><circle class="advDot" cx="'+P[0][0]+'" cy="'+P[0][1]+'" r="6"/>';}
 else{if(S.bMode==='area'&&P.length>=3)s+='<path class="advZ" d="'+d+' Z"/>';else if(P.length>=2)s+='<path class="advL" d="'+d+'"/>';
  s+=P.map(function(p){return '<circle cx="'+p[0]+'" cy="'+p[1]+'" r="5" fill="var(--advisory)" stroke="var(--surface)" stroke-width="2.5"/>';}).join('');}
 return s;}
function drawMap(gid,pins,advs,selPin,withBuilder){
 var g=document.getElementById(gid);if(!g)return;
 var s='';(advs||[]).forEach(function(a){if(a.active)s+=advSvg(a);});
 if(withBuilder)s+=builderSvg();
 (pins||[]).forEach(function(p){s+=pinSvg(p,selPin===p.id);});
 g.innerHTML=s;}
function evtToSvg(e,el){var r=el.getBoundingClientRect();var sc=Math.max(r.width/1200,r.height/760);
 var ox=(1200*sc-r.width)/2,oy=(760*sc-r.height)/2;
 return [(e.clientX-r.left+ox)/sc,(e.clientY-r.top+oy)/sc];}
function zoomOrigin(sx,sy){var el=$('#ccMapBox'),r=el.getBoundingClientRect();var sc=Math.max(r.width/1200,r.height/760);
 var ox=(1200*sc-r.width)/2,oy=(760*sc-r.height)/2;
 return (((sx*sc-ox)/r.width)*100)+'% '+(((sy*sc-oy)/r.height)*100)+'%';}
function applyCcZoom(){var z=$('#ccZoom');if(!z)return;
 if(S.ccZoomed){z.style.transformOrigin=zoomOrigin(S.ccZoomed[0],S.ccZoomed[1]);z.classList.add('on');}else z.classList.remove('on');}

